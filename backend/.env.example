# --- Приложение ---
APP_NAME=Dressly
ENVIRONMENT=dev
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
RELOAD=true

# Разрешённые источники CORS (через запятую)
CORS_ORIGINS=["http://localhost:3000"]

# --- База данных ---
DB__HOST=127.0.0.1
DB__PORT=5432
DB__USER=user
DB__PASSWORD=password
DB__DATABASE=shop
DB__POOL_SIZE=15
DB__MAX_OVERFLOW=10
DB__ECHO=false

# --- Аутентификация ---
# ОБЯЗАТЕЛЬНО замените в production (минимум 32 символа)
AUTH__SECRET_KEY=dev-secret-key-change-me-in-production
AUTH__ALGORITHM=HS256
AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH__REFRESH_TOKEN_EXPIRE_DAYS=30
